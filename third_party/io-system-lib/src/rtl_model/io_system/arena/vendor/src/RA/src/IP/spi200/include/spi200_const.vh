`ifdef SPI200_CONST_VH
`else
`define SPI200_CONST_VH

`define SPI200_PRODUCT_ID		32'h0200204c


`ifdef SPI200_AHB_MEM_SUPPORT
	`define SPI200_AHBBUS_EXIST
`elsif SPI200_REG_AHB
	`define SPI200_AHBBUS_EXIST
`endif

`ifdef SPI200_EILM_MEM_SUPPORT
	`define SPI200_EILMBUS_EXIST
`elsif SPI200_REG_EILM
	`define SPI200_EILMBUS_EXIST
`endif

`ifndef SPI200_REG_AHB
	`ifndef SPI200_REG_EILM
		`define SPI200_APBBUS_EXIST
		`ifndef SPI200_REG_APB
			`define SPI200_REG_APB
		`endif
	`endif
`endif

`ifdef SPI200_SPI_ADDR_WIDTH_24
	`define SPI200_SPI_ADDR_WIDTH	24
`else
	`define SPI200_SPI_ADDR_WIDTH	32
`endif
`define SPI200_SPI_ADDR_MSB		(`SPI200_SPI_ADDR_WIDTH - 1)

`ifdef SPI200_ADDR_WIDTH_24
	`define SPI200_HADDR_WIDTH 24
`else
	`define SPI200_HADDR_WIDTH 32
`endif

`define SPI200_HMASTER_BIT 4

`define SPI200_HSPLIT_BIT (1<<`SPI200_HMASTER_BIT)

`ifdef SPI200_AHB_MEM_SUPPORT
	`define SPI200_MEM_SUPPORT
`elsif SPI200_EILM_MEM_SUPPORT
	`define SPI200_MEM_SUPPORT
`endif

`ifdef SPI200_QUADSPI_SUPPORT
	`define SPI200_QUADDUAL_SUPPORT
`elsif SPI200_DUALSPI_SUPPORT
	`define SPI200_QUADDUAL_SUPPORT
`endif

`define SPI200_TXFIFO_WIDTH 32
`define SPI200_RXFIFO_WIDTH 32

`ifdef SPI200_TXFIFO_DEPTH_128W
	`define SPI200_TXFPTR_BITS	8
	`define SPI200_TXFIFO_DEPTH_INF	4'h6
`elsif SPI200_TXFIFO_DEPTH_64W
	`define SPI200_TXFPTR_BITS	7
	`define SPI200_TXFIFO_DEPTH_INF	4'h5
`elsif SPI200_TXFIFO_DEPTH_32W
	`define SPI200_TXFPTR_BITS	6
	`define SPI200_TXFIFO_DEPTH_INF	4'h4
`elsif SPI200_TXFIFO_DEPTH_16W
	`define SPI200_TXFPTR_BITS	5
	`define SPI200_TXFIFO_DEPTH_INF	4'h3
`elsif SPI200_TXFIFO_DEPTH_8W
	`define SPI200_TXFPTR_BITS	4
	`define SPI200_TXFIFO_DEPTH_INF	4'h2
`elsif SPI200_TXFIFO_DEPTH_4W
	`define SPI200_TXFPTR_BITS	3
	`define SPI200_TXFIFO_DEPTH_INF	4'h1
`else
	`define SPI200_TXFPTR_BITS	2
	`define SPI200_TXFIFO_DEPTH_INF	4'h0
`endif

`define SPI200_TXFIFO_DEPTH		(1 << (`SPI200_TXFPTR_BITS - 1))

`ifdef SPI200_RXFIFO_DEPTH_128W
	`define SPI200_RXFPTR_BITS	8
	`define SPI200_RXFIFO_DEPTH_INF	4'h6
`elsif SPI200_RXFIFO_DEPTH_64W
	`define SPI200_RXFPTR_BITS	7
	`define SPI200_RXFIFO_DEPTH_INF	4'h5
`elsif SPI200_RXFIFO_DEPTH_32W
	`define SPI200_RXFPTR_BITS	6
	`define SPI200_RXFIFO_DEPTH_INF	4'h4
`elsif SPI200_RXFIFO_DEPTH_16W
	`define SPI200_RXFPTR_BITS	5
	`define SPI200_RXFIFO_DEPTH_INF	4'h3
`elsif SPI200_RXFIFO_DEPTH_8W
	`define SPI200_RXFPTR_BITS	4
	`define SPI200_RXFIFO_DEPTH_INF	4'h2
`elsif SPI200_RXFIFO_DEPTH_4W
	`define SPI200_RXFPTR_BITS	3
	`define SPI200_RXFIFO_DEPTH_INF	4'h1
`else
	`define SPI200_RXFPTR_BITS	2
	`define SPI200_RXFIFO_DEPTH_INF	4'h0
`endif

`define SPI200_RXFIFO_DEPTH		(1 << (`SPI200_RXFPTR_BITS - 1))

`endif
