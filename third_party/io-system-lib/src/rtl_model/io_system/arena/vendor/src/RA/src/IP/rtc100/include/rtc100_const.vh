`define RTC100_CONST_VH

`define RTC100_PRODUCT_ID	32'h03011007

`ifdef RTC100_HALF_SECOND_SUPPORT
	`define RTC100_DIVIDER_WIDTH	14
	`define	RTC100_SEC_WIDTH	7
	`define RTC100_ST_WIDTH	8
`else
	`define RTC100_DIVIDER_WIDTH	15
	`define RTC100_SEC_WIDTH	6
	`define RTC100_ST_WIDTH      7
`endif
`define RTC100_CTL_WIDTH	9

`define RTC100_SDO_SEC_WIDTH	6
`define	RTC100_MIN_WIDTH	6
`define	RTC100_HOUR_WIDTH	5
`define	RTC100_DAY_WIDTH	`RTC100_DAY_BITS

`define RTC100_SDO_WIDTH 	(`RTC100_SDO_SEC_WIDTH + `RTC100_MIN_WIDTH + `RTC100_HOUR_WIDTH + `RTC100_DAY_WIDTH)
`define RTC100_ALM_WIDTH	(`RTC100_SDO_SEC_WIDTH + `RTC100_MIN_WIDTH + `RTC100_HOUR_WIDTH)

`endif
