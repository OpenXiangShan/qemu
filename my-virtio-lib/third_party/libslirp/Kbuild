quiet_cmd_gen_libslirp = LIB     $@
      cmd_gen_libslirp = $(MAKE) -C $(srctree)/$(src) \
				 CC="$(HOSTCC)" \
				 PKG_CONFIG="$(HOSTPKG_CONFIG)" \
				 CFLAGS="-fPIC" \
				 BUILD_DIR=$(realpath $(dir $@)) \
			 > $@.log
$(obj)/libslirp.a: FORCE
	$(call if_changed,gen_libslirp)
always-y += libslirp.a
clean-files += src/*.o src/*.d src/libslirp-version.h libslirp.a *.log
